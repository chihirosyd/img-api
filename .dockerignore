# Docker 构建上下文排除（防止敏感文件/本地数据进入镜像）
.env
config/
storage/logs/*
storage/index/*
!storage/logs/.gitkeep
!storage/index/.gitkeep
resources/local/*
!resources/local/.gitkeep
!resources/local/pc/
!resources/local/pe/
resources/local/pc/*
!resources/local/pc/default/
resources/local/pe/*
!resources/local/pe/default/
resources/local/pc/default/*
resources/local/pe/default/*
!resources/local/pc/default/.gitkeep
!resources/local/pe/default/.gitkeep
.git/
.github/
.gitignore
Dockerfile
docker-compose.yml
README.md
docs/

# 本地编译产物与 Go 开发工具输出（避免进入构建上下文）
/img-api
/img-api.exe
/server
/server.exe
/health-check
/health-check.exe
/build-index
/build-index.exe
/sync-redis
/sync-redis.exe
*.out
*.test
*.prof

# CI 打包产物（不影响镜像内容）
dist/
pkg/
