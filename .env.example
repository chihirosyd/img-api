# ============================================================
# 随机图 API 环境配置
# 复制此文件为 .env 并修改对应配置
# ============================================================

# ⚠️ 键名大小写不敏感，推荐全大写（如 APP_PORT）

# ⚠️ 值含特殊字符的写法：
#   - 值含 $ 会被当作变量展开（如 REDIS_PASSWORD=pa$sw0rd 会被错误解析），
#     请用单引号包裹：REDIS_PASSWORD='pa$sw0rd'
#   - 值含 # 会被当作注释截断，同样用单引号包裹

# 应用设置
# 调试模式：true 会显示详细错误信息，并在"分类不存在"页附可用分类清单，
# 仅供开发排查使用；默认 false（生产安全，不暴露分类清单）
APP_DEBUG=false
APP_NAME=img-api
# 监听地址（0.0.0.0 = 监听所有网卡）
APP_HOST=0.0.0.0
# 监听端口：Docker 部署时为容器内端口，改端口需同步 docker-compose.yml 的
# 端口映射右侧与 healthcheck 地址、Nginx 反代 proxy_pass、防火墙放行规则
APP_PORT=8080

# APP_VERSION 由代码内置（随发布自动更新），无需在此配置；
# 如需临时覆盖可自行添加：APP_VERSION=x.y.z

# 启动定位与桌面体验
# ⚠️ 以下两项**只能作为进程环境变量设置，写在本文件里不生效**（本文件只被读成键值表，不写回进程环境）：
#   APP_ROOT              全平台生效：项目根目录，决定 .env / resources/ / storage/ 从哪个目录算
#   IMG_API_OPEN_BROWSER  仅 Windows 生效：0 = 双击启动时不自动打开浏览器（打不开也不影响服务）
# 具体设置方式与优先级见 docs/CONFIG.md「应用设置」。

# 安全设置
# ⚠️ 本模板是面向「前方有 Nginx/OpenResty 网关」的推荐值：下面两项默认 false，
#   即跨域与限流都交给网关处理；而代码内置默认值是 true（不建 .env 时两项都开启）。
#   直接暴露端口、没有网关时，请显式改为 true。详见 docs/CONFIG.md「安全设置」。
#
# 跨域：是否允许其他网站的 JS 代码直接调用本 API（如 fetch 获取 JSON 数据）。
# 注意：博客/论坛用 <img> 标签嵌图不需要跨域（浏览器加载图片不检查 CORS），
#   只嵌图的话这里设 false、网关也不用配跨域，完全没影响。
#   true  = 允许任意网站的 JS 调用本 API（需要时仅应用或网关一侧开启即可）
#   false = 不输出跨域响应头；仍会正常处理预检请求和基础安全响应头，不影响使用。
CORS_ENABLED=false

# 限流：每个访客每分钟最多请求多少次，防止恶意刷接口。
# 实现特点：纯内存计数，重启清零；多副本部署时各副本单独计数。
# 前方有 OpenResty 网关时：
#   - 若不配 TRUSTED_PROXIES，应用看到的请求全部来自网关，
#     等于全站共用 60 次/分钟，正常访客也会被误伤（提示"请求过于频繁"）；
#   - 若想保留应用限流：需配置 TRUSTED_PROXIES，并让网关转发 X-Forwarded-For；
#   - 更推荐把限流功能交给网关做，应用这里推荐设为 false。
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX=60

# 防盗链：只允许指定网站引用本站图片，防止图片被别的网站白嫖流量。
# 逗号分隔的域名白名单（如 yourdomain.com,blog.yourdomain.com）；留空 = 不限制。
# 仅作用于图片接口（/health 不拦截；/ 仅在浏览器地址栏访问首页时豁免，
# 以 <img> 方式嵌入 / 或带 ?mode= 参数同样受保护）；
# 浏览器地址栏直接打开、命令行访问（没有来源页）默认放行
# （注意：盗链站可用 referrerpolicy=no-referrer 绕过，防盗链仅拦截普通盗链）；
# 经网关转发后此功能依然生效，无需额外配置。
REFERER_WHITELIST=

# 网关网段：填写 OpenResty/网关所在的内网网段（逗号分隔，如 172.17.0.0/16）。
# 作用：识别请求背后的"真实访客 IP"。应用只信任来自该网段的请求所携带的
#      X-Forwarded-For / X-Real-IP（且值必须是合法 IP，否则按对端 IP 计），防止访客伪造 IP。
# 是否需要：
#   - 使用应用自带限流功能（RATE_LIMIT_ENABLED=true）→ 必填，否则限流会把全站按网关 IP 统计；
#   - 限流交给网关做 → 可不填，不影响功能和首页统计；但推荐填写，
#     填写后只是使应用自带的访问日志（storage/logs）能记录真实访客 IP，便于排查问题。
#     但是OpenResty 自身的日志不会受此配置影响，它作为入口本就能记录真实访客 IP。
# 注意：填写后需让网关**覆盖**（而非透传）客户端 X-Forwarded-For，
#      （如 proxy_set_header X-Forwarded-For $remote_addr），否则伪造值会生效；
#      网段尽量填窄（能覆盖网关即可），填太宽等于放弃防伪造保护。
TRUSTED_PROXIES=

# 默认图片源: txt / local / external
DEFAULT_SOURCE=txt

# 默认分类（可选）：请求不带 category（或显式传 default）时使用的分类。
# 留空 = 使用内置 default（resources/txt/{pc|pe}/default.txt 或
# resources/local/{pc|pe}/default/ 目录）
TXT_DEFAULT_CATEGORY=
LOCAL_DEFAULT_CATEGORY=

# 本地图片索引自动刷新计划（留空或 0 = 仅在首次启动时生成一次）
# 三种写法任选其一，每次只填一个值：
#   duration：30s（秒）/ 30m（分）/ 2h（时）/ 24h（天）/ 168h（周）
#     注意：duration 没有"天/月/年"单位，天写 24h、周写 168h
#   描述符：@hourly / @daily / @weekly / @monthly / @yearly
#   cron：5 字段表达式，如 0 3 * * *（每天 03:00）、0 2 1 * *（每月 1 号 02:00）
# 示例：LOCAL_INDEX_REFRESH=@daily
#      LOCAL_INDEX_REFRESH=0 3 * * *
# 注意：新分类（新目录）即时可用；已有分类内增删图片需等计划刷新或手动重建索引
LOCAL_INDEX_REFRESH=

# Redis 缓存（可选，仅用于加速 TXT 图库的集合级随机选取；留空则不启用，端口须和`docker-compose.yml`中一致）
REDIS_ADDR=
REDIS_PASSWORD=
REDIS_DB=0

# 熔断器设置
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_TIMEOUT_SECONDS=30
CIRCUIT_HALF_OPEN_MAX=3

# 日志设置
# 注意：本模板不使用行内注释——值里的 # 会被解析器当作注释截断，含 # 的值必须用单引号包裹。
# 日志级别：debug / info / warn / error（大小写不敏感）
LOG_LEVEL=info
# 日志目录：相对路径按项目根解析，绝对路径（如 /var/log/img-api）直接使用
LOG_DIR=storage/logs
# 日志保留天数（0=永久）
LOG_MAX_AGE=30
# 单文件最大 MB（0=不限制，超限自动切分为 .1 .2 ...）
LOG_MAX_SIZE=0
