# ============================================================
# 随机图 API 环境配置
# 复制此文件为 .env 并修改对应配置
# ============================================================

# ⚠️ 键名大小写不敏感，推荐全大写（如 APP_PORT）

# ⚠️ 值含特殊字符的写法：
#   - 值含 $ 会被当作变量展开（如 REDIS_PASSWORD=pa$sw0rd 会被错误解析），
#     请用单引号包裹：REDIS_PASSWORD='pa$sw0rd'
#   - 值含 # 会被当作注释截断，同样用单引号包裹

# 应用设置
# 调试模式：true 会显示详细错误信息，并在"分类不存在"页附可用分类清单，
# 仅供开发排查使用；默认 false（生产安全，不暴露分类清单）
APP_DEBUG=false
APP_NAME=img-api
APP_HOST=0.0.0.0
APP_PORT=8080
APP_VERSION=1.4.1

# 安全设置
# CORS 跨域（前方有 Nginx 处理时可设为 false）
CORS_ENABLED=true

# 限流设置（每分钟每 IP 最大请求数）
# Nginx 反代时：确保配置了 proxy_set_header X-Forwarded-For
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=60

# Referer 防盗链（逗号分隔的域名白名单，如 yourdomain.com,blog.yourdomain.com）
# 空 Referer 默认放行（curl/浏览器地址栏），留空则不限制
REFERER_WHITELIST=

# 可信反代网段（逗号分隔的 CIDR，如 172.17.0.0/16）
# 前方有 Nginx/网关时填写其网段，限流才会按真实客户端 IP 统计（仅这些来源的
# X-Forwarded-For / X-Real-IP 会被信任）；留空 = 直接使用对端 IP（防伪造）
TRUSTED_PROXIES=

# 默认图片源: txt / local / external
DEFAULT_SOURCE=txt

# 本地图片索引自动刷新间隔（分钟，0=仅在首次启动时生成一次）
# 注意：新分类（新目录）即时可用；已有分类内增删图片需重建索引并重启加载
LOCAL_INDEX_REFRESH_MINUTES=0

# Redis 缓存（可选，仅用于加速 TXT 图库的集合级随机选取；留空则不启用，端口须和`docker-compose.yml`中一致）
REDIS_ADDR=
REDIS_PASSWORD=
REDIS_DB=0

# 熔断器设置
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_TIMEOUT_SECONDS=30
CIRCUIT_HALF_OPEN_MAX=3

# 日志设置
LOG_LEVEL=info
LOG_DIR=storage/logs
LOG_MAX_AGE=30         # 保留天数（0=永久）
LOG_MAX_SIZE=0         # 单文件最大 MB（0=不限制，超限自动切分为 .1 .2 ...）
