# 环境配置（含敏感信息）
.env
config/                   # Docker 挂载的运行时配置目录

# ── 编译产物 ──
/img-api
/img-api.exe
/server
/server.exe
/health-check
/health-check.exe
/build-index
/build-index.exe
/sync-redis
/sync-redis.exe
/build/
/dist/          # release workflow 本地复跑产物
/pkg/

# ── 日志 & 运行时文件 ──
storage/logs/*
!storage/logs/.gitkeep
storage/index/*
!storage/index/.gitkeep
*.log

# ── IDE & 编辑器 ──
.idea/
.vscode/
*.swp
*.swo
*~

# ── OS 杂项 ──
.DS_Store
Thumbs.db

# ── 本地图片（图片文件不进仓库，仅保留目录骨架）──
resources/local/*
!resources/local/.gitkeep
!resources/local/pc/
!resources/local/pe/
resources/local/pc/*
!resources/local/pc/default/
resources/local/pe/*
!resources/local/pe/default/
resources/local/pc/default/*
resources/local/pe/default/*
!resources/local/pc/default/.gitkeep
!resources/local/pe/default/.gitkeep

# ── 依赖（用 go mod download 管理）──
vendor/
