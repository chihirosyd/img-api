# 环境配置（含敏感信息）
.env
# Docker 挂载运行时生成的配置（image.yaml 示例随仓库提供）
config/.env

# ── 编译产物 ──
/img-api
/img-api.exe
/img-api-gui
/img-api-gui.exe
/server
/server.exe
/health-check
/health-check.exe
/build-index
/build-index.exe
/sync-redis
/sync-redis.exe
/setversion
/setversion.exe
/build/
# release workflow 本地复跑产物
/dist/
/pkg/

# ── Go 开发工具产物 ──
# go test -coverprofile 等覆盖率输出
*.out
# go test -c 生成的测试二进制
*.test
# pprof 性能采样
*.prof
/check-report.txt
# 本地构建缓存（GOCACHE / GOTMPDIR / GOMODCACHE 指到工作区时产生，
# 沙箱或 CI 环境下常用这种写法，避免误提交数万个缓存文件）
/.gocache/
/.gotmp/
/.gomodcache/

# ── 日志 & 运行时文件 ──
storage/logs/*
!storage/logs/.gitkeep
storage/index/*
!storage/index/.gitkeep
*.log

# ── IDE & 编辑器 ──
.idea/
.vscode/
*.swp
*.swo
*~

# ── OS 杂项 ──
.DS_Store
Thumbs.db

# ── 本地图片（图片文件不进仓库，仅保留目录骨架）──
resources/local/*
!resources/local/.gitkeep
!resources/local/pc/
!resources/local/pe/
resources/local/pc/*
!resources/local/pc/default/
resources/local/pe/*
!resources/local/pe/default/
resources/local/pc/default/*
resources/local/pe/default/*
!resources/local/pc/default/.gitkeep
!resources/local/pe/default/.gitkeep

# ── 依赖（用 go mod download 管理）──
vendor/

# ── 私人文件（审查报告/修复路线图等个人维护文档）──
# 不进仓库（不随 git 上传）、不随发布包分发（release.yml 只打包 docs/ 等目录）
private/
